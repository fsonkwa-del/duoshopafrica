{
  "name": "@duoshop/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/main.js --external:@prisma/* --external:pg --external:dotenv --external:sharp --external:@aws-sdk/*",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:db": "tsx --test src/media-job.db.test.ts",
    "demo:catalog": "tsx src/demo-catalog.ts ../../.local/demo-images"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@duoshop/database": "workspace:*",
    "@duoshop/media": "workspace:*",
    "@duoshop/payments": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.2.3",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
