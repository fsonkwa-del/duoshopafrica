# TLS automatique (Let's Encrypt) ; seul le site web est exposé, l'API reste interne
# (le site réécrit /v1/* vers l'API, webhooks CinetPay compris).
{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# Identité (Zitadel) : page de connexion Login V2 sous /ui/v2/login, le reste vers l'API Zitadel
# en HTTP/2 sans TLS (gRPC et console), comme l'exemple officiel de Zitadel.
{$AUTH_DOMAIN} {
	encode zstd gzip
	@root path /
	rewrite @root /ui/v2/login/
	handle /ui/v2/login* {
		reverse_proxy zitadel-login:3000
	}
	handle {
		reverse_proxy h2c://zitadel:8080
	}
}

# Photos (S3 SeaweedFS) : l'hôte d'origine est conservé, il fait partie des signatures.
{$MEDIA_DOMAIN} {
	request_body {
		max_size 12MB
	}
	reverse_proxy seaweedfs:8333
}
