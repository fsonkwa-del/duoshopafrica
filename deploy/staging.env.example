# Copier en deploy/staging.env (jamais versionné) et remplir. Mode TEST uniquement.
# Sans nom de domaine : sslip.io, par exemple duoshop.203-0-113-10.sslip.io et
# auth.203-0-113-10.sslip.io pour un serveur d'adresse IP 203.0.113.10.
SITE_DOMAIN=staging.example.invalid
AUTH_DOMAIN=auth.staging.example.invalid
WEB_ORIGIN=https://staging.example.invalid
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://duoshop:${POSTGRES_PASSWORD}@postgres:5432/duoshop?schema=public
# Caddy puis Next (réécriture /v1) devant l'API : nombre de relais de confiance, à vérifier.
TRUST_PROXY_HOPS=2
# Identité : Zitadel du Compose. Identifiant client créé dans la console (docs/DEPLOYMENT.md).
OIDC_ISSUER=https://auth.staging.example.invalid
OIDC_CLIENT_ID=
# Signature des cookies de la page de connexion Zitadel (au moins 32 caractères).
LOGIN_SESSION_COOKIE_SECRET=
# Paiement : CinetPay en SANDBOX ; LIVE seulement après validation sandbox, contrat et juridique.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_MODE=SANDBOX
# Stockage objet des photos (S3 compatible)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_QUARANTINE_BUCKET=duoshop-quarantine
S3_PUBLIC_BUCKET=duoshop-public
MEDIA_PUBLIC_BASE_URL=
