# Copier en deploy/staging.env (jamais versionné) et remplir. Mode TEST uniquement.
# Sans nom de domaine : sslip.io, par exemple duoshop.203-0-113-10.sslip.io et
# auth.203-0-113-10.sslip.io pour un serveur d'adresse IP 203.0.113.10.
SITE_DOMAIN=staging.example.invalid
AUTH_DOMAIN=auth.staging.example.invalid
MEDIA_DOMAIN=media.staging.example.invalid
WEB_ORIGIN=https://staging.example.invalid
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://duoshop:${POSTGRES_PASSWORD}@postgres:5432/duoshop?schema=public
# Caddy puis Next (réécriture /v1) devant l'API : nombre de relais de confiance, à vérifier.
TRUST_PROXY_HOPS=2
# Identité : Zitadel du Compose. Identifiant client créé dans la console (docs/DEPLOYMENT.md).
OIDC_ISSUER=https://auth.staging.example.invalid
OIDC_CLIENT_ID=
# Signature des cookies de la page de connexion Zitadel (au moins 32 caractères).
LOGIN_SESSION_COOKIE_SECRET=
# Paiement : CinetPay en SANDBOX ; LIVE seulement après validation sandbox, contrat et juridique.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_MODE=SANDBOX
# Paiement : Fapshi (MTN MoMo, Orange Money) en SANDBOX. Identifiants du service sandbox du tableau
# de bord Fapshi ; le secret de webhook est celui saisi sur ce même service (URL du webhook :
# https://<SITE_DOMAIN>/v1/payments/webhooks/fapshi). LIVE seulement après accord écrit de Fapshi
# sur le modèle marketplace (agrégateurs non acceptés), contrat et validation juridique.
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=
FAPSHI_MODE=SANDBOX
# Stockage objet des photos : SeaweedFS du Compose (clés identiques à deploy/s3.json).
S3_ENDPOINT=https://media.staging.example.invalid
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_QUARANTINE_BUCKET=duoshop-quarantine
S3_PUBLIC_BUCKET=duoshop-public
MEDIA_PUBLIC_BASE_URL=https://media.staging.example.invalid/duoshop-public

# Mode d'encaissement (lot 3, ADR 0011) : PLATFORM_HELD (actuel, interdit en production sans
# autorisation enregistrée), DIRECT_SELLER (paiement sur le compte marchand de chaque vendeur),
# PSP_ESCROW (refusé tant qu'aucun adaptateur n'offre le séquestre).
COLLECTION_MODE=PLATFORM_HELD
# Clé de chiffrement des comptes marchands (32 octets en base64, ex. openssl rand -base64 32).
# PAYMENT_ACCOUNTS_KEY_1=
# PAYMENT_ACCOUNTS_KEY_VERSION=1

# Coffre des pièces KYC (lot 5, ADR 0013) : bucket et identifiants DISTINCTS de ceux des photos,
# clé maîtresse de chiffrement (32 octets en base64, ex. openssl rand -base64 32), versionnée.
# KYC_S3_BUCKET=duoshop-kyc
# KYC_S3_ENDPOINT=
# KYC_S3_ACCESS_KEY_ID=
# KYC_S3_SECRET_ACCESS_KEY=
# KYC_MASTER_KEY_1=
# KYC_MASTER_KEY_VERSION=1

# Exploitation (lot 8, ADR 0016)
# Console d'administration Zitadel : adresses autorisées (CIDR séparés par des espaces).
# ADMIN_IPS=203.0.113.7/32
# Jeton de lecture de /metrics par Prometheus (32 caractères minimum, ex. openssl rand -hex 32).
# METRICS_TOKEN=
# Limites de débit partagées (fourni par compose.app.yaml) et antivirus (CLAMAV_HOST).
# REDIS_URL=redis://redis:6379
# CLAMAV_HOST=clamav
# E-mails transactionnels : serveur SMTP retenu (flux sortant à déclarer, ADR 0009).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=DuoShopAfrica <no-reply@exemple.cm>

