# Copier en deploy/zitadel.env (jamais versionné). Secrets de l'identité, lus par PostgreSQL
# (création du rôle au premier démarrage) et Zitadel. Générer chaque secret au hasard :
#   openssl rand -hex 16   (clé maître : exactement 32 caractères)
#   openssl rand -hex 24   (mots de passe)
ZITADEL_MASTERKEY=
ZITADEL_DB_PASSWORD=
ZITADEL_DATABASE_POSTGRES_DSN=postgresql://zitadel:<ZITADEL_DB_PASSWORD>@postgres:5432/zitadel?sslmode=disable
# Premier administrateur Zitadel (console https://AUTH_DOMAIN/ui/console).
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=admin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL_ADDRESS=
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=
# E-mails (vérification d'adresse des nouveaux comptes) : SMTP d'un fournisseur transactionnel.
# Laisser vide au départ ; à configurer avant d'ouvrir l'inscription à des testeurs.
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_HOST=
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_USER=
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_PASSWORD=
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_FROM=
ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_FROMNAME=DuoShopAfrica
