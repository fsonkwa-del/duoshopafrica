# LOCAL UNIQUEMENT : copier en .env et remplacer le mot de passe.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://duoshop:replace-with-a-local-password@localhost:5432/duoshop?schema=public
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Identité OIDC (Zitadel). HTTP accepté uniquement pour localhost hors production.
OIDC_ISSUER=http://localhost:8080
OIDC_CLIENT_ID=replace-with-zitadel-client-id
# OIDC_CLIENT_SECRET= (vide pour un client public PKCE)
# Photos (ADR 0006) — stockage S3-compatible ; laisser vide pour désactiver l'envoi de photos.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_QUARANTINE_BUCKET=duoshop-quarantine
S3_PUBLIC_BUCKET=duoshop-public
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:8333/duoshop-public
# Paiements (ADR 0007) : simulateur local uniquement, refusé en production.
PAYMENTS_MOCK_ENABLED=false
PAYMENTS_MOCK_SECRET=
# Connexion de démonstration (local uniquement, refusée en production).
DEV_LOGIN_ENABLED=false
# CinetPay (ADR 0007) : actif seulement si les deux identifiants sont fournis ; SANDBOX par défaut.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_MODE=SANDBOX
# Reverse proxies de confiance devant l'API (0 en local).
TRUST_PROXY_HOPS=0
